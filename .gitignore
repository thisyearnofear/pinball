*.tsbuildinfo
build.sh

# Lockfiles — exactly one resolution per package, and it is committed.
#
# The frontend is a pnpm project (pnpm-lock.yaml, the root's only lockfile).
# backend/ is an npm package: package-lock.json is what the deploy server
# installs from with `npm ci`, so it is tracked and must not be ignored — a
# deletion there would silently drop the pin the deployment resolves from.
*-lock.json
!backend/package-lock.json
# contracts/ keeps the rule: it resolves through the tracked
# contracts/pnpm-lock.yaml, so an npm lockfile there is only a stray second
# resolution.

# Hardhat/Contracts
contracts/artifacts/
contracts/cache/
contracts/typechain-types/

