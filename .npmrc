# Make `engines` in package.json a hard requirement instead of a warning: an
# install on the wrong Node version fails with ERR_PNPM_UNSUPPORTED_ENGINE rather
# than quietly proceeding. Node 24 is pinned in .nvmrc and read by CI.
engine-strict=true

# Always resolve from the committed pnpm-lock.yaml.
#
# pnpm only defaults to this when it detects CI=true, so without it the guarantee
# rests on the builder's environment rather than on the repo. Netlify does set CI
# and does read pnpm-lock.yaml, but that is an implicit contract with a host whose
# build config this repo only partly controls; set here, one identical rule covers
# local, CI and Netlify. A lockfile that disagrees with package.json now fails with
# ERR_PNPM_OUTDATED_LOCKFILE instead of silently installing a tree nobody tested.
frozen-lockfile=true
