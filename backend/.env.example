# Server configuration
PORT=8080

# Score signing configuration
SCORE_SIGNER_PK=0xYOUR_PRIVATE_KEY
# Optional (for ops visibility)
SCORE_SIGNER_ADDR=0xYOUR_PUBLIC_ADDRESS

# Must match the chain ID where the tournament contract is deployed
CHAIN_ID=0

# Optional: score signing prefix (must match the contract)
SCORE_PREFIX=PINBALL_SCORE:v2

# RPC used by the backend when it needs to broadcast transactions (e.g. Sponsored Missions payouts)
MEZO_RPC_URL=https://rpc.test.mezo.org

# Optional differentiator: Sponsored Missions contract address (MissionPool)
MISSION_POOL_ADDRESS=

# Optional: minimum score required to trigger a mission award (hackathon-simple rule)
MISSION_SCORE_THRESHOLD=250000

# Optional: require multiball flag in metadata to award mission (enables "Jackpot Multiball")
MISSION_REQUIRE_MULTIBALL=false

# CORS configuration (comma-separated origins)
ALLOWED_ORIGINS=https://your-netlify-site.netlify.app,https://your-domain.tld

# Global rate limit (requests per minute, all endpoints)
RATE_LIMIT=120

# Score submission validation constraints
# Maximum allowed score (prevents obviously bogus submissions)
MAX_SCORE=10000000

# Maximum player name length in characters
PLAYER_NAME_MAX_LENGTH=64

# Maximum metadata JSON size in bytes
MAX_METADATA_LENGTH=10000

# Per-address rate limiting for score signatures
# Maximum signature requests allowed per player
SCORE_SIGNATURE_RATE_LIMIT_MAX=3

# Time window for per-address rate limiting (milliseconds)
# Default: 5 minutes (300000 ms)
SCORE_SIGNATURE_RATE_LIMIT_WINDOW=300000

# Optional: Redis URL for persistent rate limiting and nonce tracking.
# When unset, uses in-memory stores (fine for local dev, resets on restart).
# REDIS_URL=redis://localhost:6379

# NIM payment integration (Nimiq Mini Apps Competition bonus points).
# Players can pay the tournament entry fee in NIM; the backend verifies the
# tx on the Nimiq chain against this treasury before registering the player.
NIM_TREASURY_ADDRESS=NQ88 8AG0 1CXT 9Y11 77FU L706 M1TA R1FC DNKU
# Minimum entry fee in Luna (1 NIM = 100000 Luna).
NIM_ENTRY_FEE_LUNA=100000
# Nimiq mainnet JSON-RPC used to verify NIM transactions.
NIMIQ_RPC_URL=https://rpc.nimiq-mainnet.nimiq-network.com

# Quantum-seeded runs (optional). When QUANTUM_SEED_URL is set, /api/quantum/seed
# sources run seeds from an HTTP-JSON QRNG (ANU-QRNG compatible shape:
# { data: [uint16, ...] }); otherwise it returns CSPRNG seeds. Runs stay fully
# replay-verifiable either way — the seed is recorded in the replay digest.
# Example (ANU QRNG): https://qrng.anu.edu.au/API/jsonI.php
# QUANTUM_SEED_URL=
# QUANTUM_SEED_API_KEY=
QUANTUM_SEED_TIMEOUT_MS=2000

# Provider: anu (default, the HTTP-JSON QRNG above) or moth (MOTH comet-qrng-v1
# randomness beacon). With moth, seeds come from a background-refilled pool of
# finished jobs, each batch carrying its job id / pulse hash / backend / Bell
# witness flag. No key or any MOTH failure ⇒ CSPRNG seeds (source: csprng).
# QUANTUM_SEED_PROVIDER=moth
# MOTH_API_KEY=
# emu = Aer simulator (seconds; labelled SIMULATED QRNG, not quantum hardware).
# qpu = IBM quantum hardware (queues for minutes; labelled QPU-SEEDED).
MOTH_SEED_MODE=emu
# Optional tuning (defaults shown): integers per job, shots per job, job budget
# (emu 60000 / qpu 1800000 ms) and poll interval (emu 2000 / qpu 15000 ms).
# MOTH_SEED_BATCH=32
# MOTH_SEED_SHOTS=4096
# MOTH_SEED_TIMEOUT_MS=
# MOTH_SEED_POLL_MS=
# MOTH_API_URL=https://api.mothquantum.com/api/v1

# Daily Kami seed bank (docs/QUANTUM_SEEDS.md). The bank holds every future
# daily seed: keep it out of git and deploy as a secret. Unset ⇒ daily runs use
# ordinary seeds. Generate with: npm run bank-daily -- --days 366
DAILY_SEED_BANK_PATH=
# DAILY_SEED_BANK_JSON=
# DAILY_SEED_BANK_ROOT=0x…
