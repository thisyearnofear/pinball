# ────────────────────────────────────────────────────────────────
# Ecosystem Profile System
# ────────────────────────────────────────────────────────────────
# The app supports multiple blockchain ecosystems via profiles.
# Set NEXT_PUBLIC_ECOSYSTEM_PROFILE to select which one to use.
# Each profile has its own chain, wallet adapter, and payment token.

# ── Mezo Profile (default, backward-compatible) ─────────────────
# NEXT_PUBLIC_ECOSYSTEM_PROFILE=mezo
# NEXT_PUBLIC_WALLET_ADAPTER=wagmi
# NEXT_PUBLIC_CHAIN_ID=31611
# NEXT_PUBLIC_RPC_URL_PUBLIC=https://rpc.test.mezo.org
# NEXT_PUBLIC_PAYMENT_TOKEN_TYPE=erc20
# NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=  (MUSD address)
# NEXT_PUBLIC_PAYMENT_TOKEN_SYMBOL=MUSD
# NEXT_PUBLIC_PAYMENT_TOKEN_DECIMALS=18

# ── Nimiq Profile (Nimiq Pay Mini App Competition) ──────────────
# NEXT_PUBLIC_ECOSYSTEM_PROFILE=nimiq
# NEXT_PUBLIC_WALLET_ADAPTER=nimiq
# NEXT_PUBLIC_CHAIN_ID=137
# NEXT_PUBLIC_RPC_URL_PUBLIC=https://polygon-rpc.com
# NEXT_PUBLIC_PAYMENT_TOKEN_TYPE=native
# NEXT_PUBLIC_PAYMENT_TOKEN_SYMBOL=NIM
# NEXT_PUBLIC_PAYMENT_TOKEN_DECIMALS=18
# (or use USDT on Polygon: type=erc20, address=<USDT on Polygon>, symbol=USDT)

# ────────────────────────────────────────────────────────────────
# Required for all profiles
# ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=31611
NEXT_PUBLIC_RPC_URL_PUBLIC=https://rpc.test.mezo.org
NEXT_PUBLIC_TOURNAMENT_MANAGER_ADDRESS=

# Payment token (ERC-20 address for MUSD/USDT, or empty for native tokens)
# Legacy: NEXT_PUBLIC_MUSD_ADDRESS is still read as a fallback.
NEXT_PUBLIC_PAYMENT_TOKEN_TYPE=erc20
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=
NEXT_PUBLIC_PAYMENT_TOKEN_SYMBOL=MUSD
NEXT_PUBLIC_PAYMENT_TOKEN_DECIMALS=18

# Optional: mission pool
# NEXT_PUBLIC_MISSION_POOL_ADDRESS=

# Backend for score signing
NEXT_PUBLIC_BACKEND_URL=

# Optional - chain UX metadata for wallet_addEthereumChain
# NEXT_PUBLIC_CHAIN_NAME=Mezo Testnet
# NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://explorer.test.mezo.org
# NEXT_PUBLIC_NATIVE_CURRENCY_NAME=BTC
# NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=BTC
# NEXT_PUBLIC_NATIVE_CURRENCY_DECIMALS=18

# Optional - score signing prefix (defaults to PINBALL_SCORE:v2)
# NEXT_PUBLIC_SCORE_PREFIX=

# Optional - active mission ID for Sponsored Missions
# NEXT_PUBLIC_ACTIVE_MISSION_ID=

# Optional - Sentry error tracking
# NEXT_PUBLIC_SENTRY_DSN=**********************************************
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=your-auth-token
