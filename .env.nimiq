# Nimiq Pay Mini App Competition profile (Polygon Amoy testnet)
# Copy these into .env to switch to the Nimiq ecosystem profile.

# Ecosystem profile
NEXT_PUBLIC_ECOSYSTEM_PROFILE=nimiq
NEXT_PUBLIC_WALLET_ADAPTER=nimiq

# Polygon Amoy testnet
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_RPC_URL_PUBLIC=https://polygon-amoy.publicnode.com
NEXT_PUBLIC_CHAIN_NAME=Polygon Amoy
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
NEXT_PUBLIC_NATIVE_CURRENCY_NAME=POL
NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=POL
NEXT_PUBLIC_NATIVE_CURRENCY_DECIMALS=18

# Payment token: test USDT (ERC-20, 6 decimals)
NEXT_PUBLIC_PAYMENT_TOKEN_TYPE=erc20
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=0xD391D6131F92E0A9717a98aD69BAeCfcA4c23A66
NEXT_PUBLIC_PAYMENT_TOKEN_SYMBOL=USDT
NEXT_PUBLIC_PAYMENT_TOKEN_DECIMALS=6

# Contract addresses (Polygon Amoy)
NEXT_PUBLIC_TOURNAMENT_MANAGER_ADDRESS=0x711aB8af92bA35C3ce910468e45b3B0097C6C860
NEXT_PUBLIC_MISSION_POOL_ADDRESS=0xf0Fc8d4Ad5b00AF6aAb4E74Cd59B67c4eEB2FD49
NEXT_PUBLIC_ACTIVE_MISSION_ID=1

# Backend for score signing (update when backend is redeployed)
NEXT_PUBLIC_BACKEND_URL=

# Score signing prefix (same as Mezo)
NEXT_PUBLIC_SCORE_PREFIX=PINBALL_SCORE:v2
