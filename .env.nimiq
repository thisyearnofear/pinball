# Nimiq Pay Mini App Competition profile — PRODUCTION (Polygon mainnet)
# Copy these into .env to run the Nimiq ecosystem profile locally.
# These mirror the live [build.environment] in netlify.toml.

# Ecosystem profile
NEXT_PUBLIC_ECOSYSTEM_PROFILE=nimiq
NEXT_PUBLIC_WALLET_ADAPTER=nimiq

# Polygon mainnet
NEXT_PUBLIC_CHAIN_ID=137
NEXT_PUBLIC_RPC_URL_PUBLIC=https://polygon.drpc.org
NEXT_PUBLIC_CHAIN_NAME=Polygon
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://polygonscan.com
NEXT_PUBLIC_NATIVE_CURRENCY_NAME=POL
NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=POL
NEXT_PUBLIC_NATIVE_CURRENCY_DECIMALS=18

# Payment token: USDT (ERC-20, 6 decimals) on Polygon mainnet
NEXT_PUBLIC_PAYMENT_TOKEN_TYPE=erc20
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
NEXT_PUBLIC_PAYMENT_TOKEN_SYMBOL=USDT
NEXT_PUBLIC_PAYMENT_TOKEN_DECIMALS=6

# Contract addresses (Polygon mainnet)
NEXT_PUBLIC_TOURNAMENT_MANAGER_ADDRESS=0x39067C81a3ccc3184000b88b7466A4A77B59cfa0
NEXT_PUBLIC_MISSION_POOL_ADDRESS=
NEXT_PUBLIC_ACTIVE_MISSION_ID=

# Backend for score signing (live on VPS)
NEXT_PUBLIC_BACKEND_URL=https://api.pinball.sportwarren.com

# Score signing prefix
NEXT_PUBLIC_SCORE_PREFIX=PINBALL_SCORE:v2

# NIM native payment path (bonus points)
NEXT_PUBLIC_NIM_TREASURY_ADDRESS=NQ88 8AG0 1CXT 9Y11 77FU L706 M1TA R1FC DNKU
NEXT_PUBLIC_NIM_ENTRY_FEE=1
