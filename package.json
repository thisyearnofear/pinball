{
  "name": "kamikaze-ball",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest --environment jsdom --no-watch",
    "sim:kamikaze": "vitest run --config vitest.sim.config.ts",
    "typecheck": "tsc --noEmit",
    "generate-manifest": "node scripts/generate-manifest.js",
    "test:frontend": "pnpm run typecheck && pnpm test && pnpm run build",
    "test:backend": "pnpm --prefix backend test",
    "test:contracts": "pnpm --prefix contracts test",
    "test:all": "pnpm run test:frontend && pnpm run test:backend && pnpm run test:contracts",
    "ci": "pnpm run test:frontend && pnpm --prefix backend install --no-frozen-lockfile && pnpm --prefix backend test && pnpm --prefix contracts install --no-frozen-lockfile && pnpm --prefix contracts test"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.3",
    "@sentry/nextjs": "10.53.1",
    "@tanstack/react-query": "5.62.2",
    "axios": "1.13.6",
    "ethers": "^6.15.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "viem": "^2.21.53",
    "wagmi": "^2.14.6"
  },
  "devDependencies": {
    "@types/matter-js": "^0.18.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "bowser": "^2.11.0",
    "eslint": "^8.44.0",
    "jsdom": "^21.1.1",
    "lodash.throttle": "^4.1.1",
    "matter-attractors": "^0.1.6",
    "matter-js": "^0.19.0",
    "pathseg": "^1.2.1",
    "poly-decomp": "^0.3.0",
    "sass": "^1.51.0",
    "svg-path-properties": "^2.0.2",
    "tiny-script-loader": "^2.2.1",
    "typescript": "5.6.3",
    "vite": "^6.2.5",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^3.0.7",
    "vitest-canvas-mock": "^0.3.3",
    "zcanvas": "^6.0.5"
  },
  "description": "_Pinball Schminball_ is a retro-style vertically scrolling pinball game created to showcase the possibilities of creating a game using the open source [zCanvas library](https://github.com/igorski/zCanvas) for graphics rendering, this time enriched by using Matter JS as a physics engine.",
  "main": ".eslintrc.js",
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
