        </Shape>
        <Shape x="68" y="16" name="Pip3" id="0:15" opacity="0">
            <Ellipse width="14" height="14" name="Pip3Path"/>
            <Fill name="Lit"><SolidColor colorValue="E667E8F9" name="Color"/></Fill>
        </Shape>

        <!-- Per-level appearances: each state keys the fills it owns. All fills
             author 0 opacity, so M0/ArmedOff author nothing. -->
        <LinearAnimation duration="8" name="M0" id="0:60"/>
        <LinearAnimation duration="8" name="M1" id="0:61">
            <KeyedObject objectId="0:13">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="8" name="M2" id="0:62">
            <KeyedObject objectId="0:13">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:14">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" interpolationType="hold" frame="0"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="8" name="M3" id="0:63">
