    <!-- ── coach_kanji ──────────────────────────────────────────────
         Ink-brush reveal that sits behind the DOM kanji glyph. Host
         pulses `reveal` (bool) when a cue mounts: splash pops, ripple
         fades out. The glyph itself stays DOM text (font-free .riv). -->
    <Artboard defaultStateMachineId="0:107" viewModelId="0:110" clip="false" width="120" height="120" name="coach_kanji" id="0:100">
        <Fill name="Background"><SolidColor colorValue="00000000" name="Color"/></Fill>
