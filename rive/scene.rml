        </Shape>
        <Shape x="42" y="16" name="Pip2" id="0:14" opacity="0">
            <Ellipse width="14" height="14" name="Pip2Path"/>
            <Fill name="Lit"><SolidColor colorValue="E667E8F9" name="Color"/></Fill>
        </Shape>
        <Shape x="68" y="16" name="Pip3Track" id="0:12">
            <Ellipse width="14" height="14" name="Pip3TrackPath"/>
