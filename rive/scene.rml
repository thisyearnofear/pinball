<Rive version="1" kind="fragment">

    <!-- ── hud_gauge ────────────────────────────────────────────────
         Story HUD resources as one driven component: three mana pips
         (fill follows the mana count) and an armed glow (bool →
         visible). Host drives: mana 0..3, armed bool. The live charge
         ring stays DOM — it tracks the aim point every frame.          -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" clip="false" width="100" height="32" name="hud_gauge" id="0:2">
        <Fill name="Background"><SolidColor colorValue="00000000" name="Color"/></Fill>
        <LayoutComponentStyle name="Gauge Style" id="0:3"/>

        <!-- Armed glow bar behind the pips -->
        <Shape x="8" y="16" name="ArmedGlow" id="0:16" opacity="0">
            <Rectangle width="76" height="16" originX="0" originY="0.5" name="GlowRect" cornerRadiusTL="8" cornerRadiusTR="8" cornerRadiusBL="8" cornerRadiusBR="8"/>
            <Fill name="GlowFill"><SolidColor colorValue="5267E8F9" name="Color"/></Fill>
        </Shape>

        <!-- Mana pips: track (dim) + fill (lit). Fills author 0 opacity;
             each mana state's animation lights exactly its pips. -->
        <Shape x="16" y="16" name="Pip1Track" id="0:10">
            <Ellipse width="14" height="14" name="Pip1TrackPath"/>
            <Fill name="Track"><SolidColor colorValue="26103249" name="Color"/></Fill>
        </Shape>
        <Shape x="16" y="16" name="Pip1" id="0:13" opacity="0">
            <Ellipse width="14" height="14" name="Pip1Path"/>
            <Fill name="Lit"><SolidColor colorValue="E667E8F9" name="Color"/></Fill>
        </Shape>
        <Shape x="42" y="16" name="Pip2Track" id="0:11">
            <Ellipse width="14" height="14" name="Pip2TrackPath"/>
